# ══ SISDAH — Plantilla de configuración ══════════════════════════════════════
# Copia este fichero como ".env" y rellena los valores reales.
# NUNCA subas el .env real al repositorio.

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_SEGURA

# ── Base de datos ─────────────────────────────────────────────────────────────
USE_SQLITE=0
DB_HOST=localhost
DB_PORT=3306
DB_USER=sisdah_app
DB_PASSWORD=CAMBIA_ESTO
DB_NAME=sisdah

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=0
SESSION_SECURE=0

# ── Acceso de emergencia ──────────────────────────────────────────────────────
EMERGENCY_DNI=TU_DNI_AQUI
